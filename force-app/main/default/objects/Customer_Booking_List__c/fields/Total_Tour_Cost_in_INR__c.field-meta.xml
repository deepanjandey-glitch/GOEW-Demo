<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Tour_Cost_in_INR__c</fullName>
    <description>Total tour cost in INR including taxes: INR part, forex part and optional tours, each with 5% GST and 2% TCS on (cost + GST).</description>
    <formula>Total_FOREX_in_INR__c + Optional_Tour_Cost_in_INR__c + (Total_INR__c * 1.05 * 1.02)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Tour Cost in INR</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
